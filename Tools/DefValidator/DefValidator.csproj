<Project Sdk="Microsoft.NET.Sdk">

  <!-- Outil de développement (non livré au joueur, non lu par RimWorld).
       Vérifie les Defs XML du mod contre les DLL du jeu et des dépendances,
       sans lancer RimWorld. Voir Tools/README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DefValidator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.*" />
  </ItemGroup>

</Project>
