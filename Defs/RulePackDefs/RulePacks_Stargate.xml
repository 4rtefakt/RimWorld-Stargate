<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Noms des seigneurs goa'uld, partagés par les autres générateurs (via include).
       [delord] gère l'élision : "de Ra" / "d'Apophis". -->
  <RulePackDef>
    <defName>SG_GoauldLordNames</defName>
    <rulePack>
      <rulesStrings>
        <li>lord->[lordC]</li>
        <li>lord->[lordV]</li>
        <li>delord->de [lordC]</li>
        <li>delord->d'[lordV]</li>

        <li>lordC->Ra</li>
        <li>lordC->Sokar</li>
        <li>lordC->Cronos</li>
        <li>lordC->Ba'al</li>
        <li>lordC->Maître Yu</li>
        <li>lordC->Hathor</li>
        <li>lordC->Nirrti</li>
        <li>lordC->Heru'ur</li>
        <li>lordC->Camulus</li>
        <li>lordC->Moloc</li>
        <li>lordC->Seth</li>
        <li>lordC->Zipacna</li>
        <li>lordC->Tanith</li>
        <li>lordC->Kali</li>
        <li>lordC->Svarog</li>

        <li>lordV->Apophis</li>
        <li>lordV->Anubis</li>
        <li>lordV->Osiris</li>
        <li>lordV->Imhotep</li>
        <li>lordV->Amaterasu</li>
        <li>lordV->Olokun</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <!-- Noms de faction goa'uld : "Empire d'Apophis", "Dominion de Ra", etc. -->
  <RulePackDef>
    <defName>SG_NamerFactionGoauld</defName>
    <include>
      <li>SG_GoauldLordNames</li>
    </include>
    <rulePack>
      <rulesStrings>
        <li>r_name->[union] [delord]</li>
        <li>r_name->[adjectif] [union] [delord]</li>
        <li>r_name->[lord] et son [union]</li>

        <li>union->Empire</li>
        <li>union->Dominion</li>
        <li>union->Domaine</li>
        <li>union->Règne</li>
        <li>union->Trône</li>

        <li>adjectif->Divin</li>
        <li>adjectif->Éternel</li>
        <li>adjectif->Glorieux</li>
        <li>adjectif->Grand</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <!-- Noms de Ha'tak (vaisseaux-mères goa'uld) : "Glaive d'Apophis", "Ha'tak de Ba'al"… -->
  <RulePackDef>
    <defName>SG_NamerHatak</defName>
    <include>
      <li>SG_GoauldLordNames</li>
    </include>
    <rulePack>
      <rulesStrings>
        <li>r_name(p=2)->[shipNoun] [delord]</li>
        <li>r_name->Ha'tak [delord]</li>
        <li>r_name->Vaisseau-mère [delord]</li>

        <li>shipNoun->Colère</li>
        <li>shipNoun->Glaive</li>
        <li>shipNoun->Œil</li>
        <li>shipNoun->Fureur</li>
        <li>shipNoun->Main</li>
        <li>shipNoun->Serpent</li>
        <li>shipNoun->Faucon</li>
        <li>shipNoun->Aile</li>
        <li>shipNoun->Voix</li>
        <li>shipNoun->Flamme</li>
        <li>shipNoun->Jugement</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <!-- Noms de colonie goa'uld : syllabes type "Chulak", "Dakara", "Netu". -->
  <RulePackDef>
    <defName>SG_NamerSettlementGoauld</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name(p=2)->[syl][sylFin]</li>
        <li>r_name->[syl][syl][sylFin]</li>
        <li>r_name->[syl][sylFin] Prime</li>

        <li>syl->Chu</li>
        <li>syl->Da</li>
        <li>syl->Ne</li>
        <li>syl->Tar</li>
        <li>syl->Aby</li>
        <li>syl->Del</li>
        <li>syl->Ju</li>
        <li>syl->Ke</li>
        <li>syl->Pra</li>
        <li>syl->Vor</li>
        <li>syl->Tol</li>
        <li>syl->Cas</li>

        <li>sylFin->lak</li>
        <li>sylFin->kara</li>
        <li>sylFin->tu</li>
        <li>sylFin->dos</li>
        <li>sylFin->mac</li>
        <li>sylFin->nai</li>
        <li>sylFin->vanc</li>
        <li>sylFin->ash</li>
        <li>sylFin->ren</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

</Defs>
