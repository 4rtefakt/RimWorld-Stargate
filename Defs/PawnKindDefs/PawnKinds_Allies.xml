<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       Pawnkinds des factions alliées/neutres : Tau'ri (SGC), Tok'ra,
       Jaffa libres, Asgard. Xénotype imposé par le pawnkind (comme les
       Goa'uld), backstories thématiques (Backstories_Allies.xml).
       Tags d'armes/vêtements vanilla : Gun, AssaultRifle, SimpleGun,
       SpacerGun ; IndustrialBasic, IndustrialMilitaryBasic/Advanced.
       ============================================================ -->

  <PawnKindDef Name="SG_AllyPawnBase" Abstract="True">
    <race>Human</race>
    <invNutrition>2.55</invNutrition>
    <useFactionXenotypes>false</useFactionXenotypes>
    <itemQuality>Normal</itemQuality>
    <gearHealthRange>0.8~1.2</gearHealthRange>
    <initialResistanceRange>15~25</initialResistanceRange>
    <initialWillRange>2~4</initialWillRange>
  </PawnKindDef>

  <!-- ===================== TAU'RI (SGC) ===================== -->
  <PawnKindDef Name="SG_TauriPawnBase" ParentName="SG_AllyPawnBase" Abstract="True">
    <defaultFactionDef>SG_TauriSGC</defaultFactionDef>
    <xenotypeSet>
      <xenotypeChances>
        <SG_Tauri>999</SG_Tauri>
      </xenotypeChances>
    </xenotypeSet>
  </PawnKindDef>

  <PawnKindDef ParentName="SG_TauriPawnBase">
    <defName>SG_SGCSoldier</defName>
    <label>soldat du SGC</label>
    <combatPower>75</combatPower>
    <isFighter>true</isFighter>
    <backstoryFiltersOverride>
      <li>
        <categoriesChildhood>
          <li>SG_TauriChild</li>
        </categoriesChildhood>
        <categoriesAdulthood>
          <li>SG_TauriSoldier</li>
        </categoriesAdulthood>
      </li>
    </backstoryFiltersOverride>
    <weaponMoney>350~800</weaponMoney>
    <weaponTags>
      <li>Gun</li>
      <li>AssaultRifle</li>
    </weaponTags>
    <apparelMoney>400~800</apparelMoney>
    <apparelRequired>
      <li>SG_SGCUniform</li>
    </apparelRequired>
    <apparelTags>
      <li>IndustrialMilitaryBasic</li>
    </apparelTags>
    <apparelAllowHeadgearChance>0.8</apparelAllowHeadgearChance>
  </PawnKindDef>

