      <li Class="StockGenerator_SingleDef"><thingDef>Silver</thingDef><countRange>800~1500</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>SG_Naquadah</thingDef><countRange>60~150</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>ComponentSpacer</thingDef><countRange>2~5</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>SG_Zat</thingDef><countRange>1~3</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>SG_KaraKesh</thingDef><countRange>0~2</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>SG_TokraSymbiote</thingDef><countRange>0~1</countRange></li>
    </stockGenerators>
  </TraderKindDef>

