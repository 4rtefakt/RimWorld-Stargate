<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       Marchands des factions Stargate (caravanes, visiteurs, comptoirs).
       Tous rachètent l'équipement Stargate (tradeTag SG_StargateTech),
       les objets de valeur et l'art.
       ============================================================ -->

  <TraderKindDef Name="SG_TraderBase" Abstract="True">
    <stockGenerators>
      <li Class="StockGenerator_BuyExpensiveSimple" />
      <li Class="StockGenerator_BuyTradeTag"><tag>Art</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>SG_StargateTech</tag></li>
    </stockGenerators>
  </TraderKindDef>

  <!-- Stock général des comptoirs (colonies) Stargate, en plus de leurs objets dédiés :
       sans lui, un comptoir ne vendait que 5 ou 6 objets, loin des comptoirs vanilla.
       Pas d'esclaves : ces factions combattent l'esclavage goa'uld. -->
  <TraderKindDef Name="SG_BaseTraderBase" ParentName="SG_TraderBase" Abstract="True">
    <stockGenerators>
      <!-- Ressources -->
      <li Class="StockGenerator_SingleDef"><thingDef>Steel</thingDef><countRange>200~500</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>ComponentIndustrial</thingDef><countRange>6~15</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>Chemfuel</thingDef><countRange>80~200</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>Gold</thingDef><countRange>-20~60</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>Uranium</thingDef><countRange>-20~60</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>Cloth</thingDef><countRange>100~300</countRange></li>
      <li Class="StockGenerator_Category">
        <categoryDef>Textiles</categoryDef>
        <thingDefCountRange>1~3</thingDefCountRange>
        <totalPriceRange>300~700</totalPriceRange>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>ResourcesRaw</categoryDef>
        <thingDefCountRange>2~3</thingDefCountRange>
        <totalPriceRange>200~600</totalPriceRange>
      </li>
      <!-- Nourriture et soins -->
      <li Class="StockGenerator_SingleDef"><thingDef>Pemmican</thingDef><countRange>150~400</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>MealSurvivalPack</thingDef><countRange>10~30</countRange></li>
      <li Class="StockGenerator_Category">
        <categoryDef>FoodRaw</categoryDef>
        <excludedCategories>
          <li>EggsFertilized</li>
        </excludedCategories>
        <thingDefCountRange>2~4</thingDefCountRange>
        <totalPriceRange>300~700</totalPriceRange>
      </li>
      <li Class="StockGenerator_SingleDef"><thingDef>MedicineIndustrial</thingDef><countRange>10~25</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>Neutroamine</thingDef><countRange>10~40</countRange></li>
      <li Class="StockGenerator_Category">
        <categoryDef>Drugs</categoryDef>
        <thingDefCountRange>1~3</thingDefCountRange>
        <totalPriceRange>300~800</totalPriceRange>
      </li>
      <!-- Armes et vêtements -->
      <li Class="StockGenerator_MarketValue">
        <tradeTag>WeaponRanged</tradeTag>
        <countRange>2~4</countRange>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>WeaponsMelee</categoryDef>
        <thingDefCountRange>1~3</thingDefCountRange>
        <countRange>1~2</countRange>
      </li>
      <li Class="StockGenerator_MarketValue">
        <tradeTag>BasicClothing</tradeTag>
        <countRange>4~10</countRange>
      </li>
      <li Class="StockGenerator_MarketValue">
        <tradeTag>Armor</tradeTag>
        <countRange>1~3</countRange>
      </li>
      <!-- Exotique -->
      <li Class="StockGenerator_Techprints">
        <countChances>
          <li><count>1</count><chance>0.5</chance></li>
          <li><count>2</count><chance>0.5</chance></li>
        </countChances>
      </li>
      <li Class="StockGenerator_Tag">
        <tradeTag>Artifact</tradeTag>
        <thingDefCountRange>0~2</thingDefCountRange>
        <countRange>1~1</countRange>
      </li>
      <li Class="StockGenerator_Animals">
        <maxWildness>0.70</maxWildness>
        <tradeTagsSell>
          <li>AnimalFarm</li>
          <li>AnimalPet</li>
        </tradeTagsSell>
        <tradeTagsBuy>
          <li>AnimalUncommon</li>
          <li>AnimalExotic</li>
        </tradeTagsBuy>
        <kindCountRange>1~3</kindCountRange>
        <countRange>1~3</countRange>
      </li>
    </stockGenerators>
  </TraderKindDef>

  <!-- ===================== TAU'RI (SGC) ===================== -->
  <TraderKindDef ParentName="SG_TraderBase">
    <defName>SG_Caravan_Tauri</defName>
    <label>convoi d'intendance du SGC</label>
    <stockGenerators>
      <li Class="StockGenerator_SingleDef"><thingDef>Silver</thingDef><countRange>400~900</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>MedicineIndustrial</thingDef><countRange>3~8</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>ComponentIndustrial</thingDef><countRange>3~8</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>SG_SGCUniform</thingDef><countRange>1~3</countRange></li>
      <li Class="StockGenerator_MarketValue">
        <tradeTag>WeaponRanged</tradeTag>
        <maxTechLevelGenerate>Industrial</maxTechLevelGenerate>
        <countRange>1~3</countRange>
      </li>
    </stockGenerators>
  </TraderKindDef>

  <TraderKindDef ParentName="SG_TraderBase">
    <defName>SG_Visitor_Tauri</defName>
    <label>équipe SG</label>
    <stockGenerators>
      <li Class="StockGenerator_SingleDef"><thingDef>Silver</thingDef><countRange>100~300</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>MedicineIndustrial</thingDef><countRange>1~3</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>SG_SGCUniform</thingDef><countRange>0~1</countRange></li>
    </stockGenerators>
  </TraderKindDef>

  <TraderKindDef ParentName="SG_BaseTraderBase">
    <defName>SG_Base_Tauri</defName>
    <label>base du SGC</label>
    <stockGenerators>
      <li Class="StockGenerator_SingleDef"><thingDef>Silver</thingDef><countRange>800~1500</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>SG_SGCUniform</thingDef><countRange>2~5</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>SG_Naquadah</thingDef><countRange>0~30</countRange></li>
    </stockGenerators>
  </TraderKindDef>

