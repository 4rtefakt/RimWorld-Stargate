      <li Class="StockGenerator_SingleDef"><thingDef>SG_Naquadah</thingDef><countRange>10~30</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>SG_Zat</thingDef><countRange>0~1</countRange></li>
