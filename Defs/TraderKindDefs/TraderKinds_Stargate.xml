      <li Class="StockGenerator_SingleDef"><thingDef>ComponentSpacer</thingDef><countRange>1~3</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>SG_Zat</thingDef><countRange>1~2</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>SG_KaraKesh</thingDef><countRange>0~1</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>SG_TokraSymbiote</thingDef><countRange>-2~1</countRange></li>
